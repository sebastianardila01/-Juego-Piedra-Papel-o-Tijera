Proceso PiedraPapelTijera

	Definir jugador, maquina Como Entero
	Definir opciones Como Cadena

	Escribir "👊 Bienvenido a Piedra, Papel o Tijera"
	Escribir "Elige una opción:"
	Escribir "1. Piedra"
	Escribir "2. Papel"
	Escribir "3. Tijera"
	Leer jugador

	maquina <- Aleatorio(1, 3)

	Escribir "Tu elección: ", jugador
	Escribir "Elección de la máquina: ", maquina

	Si jugador = maquina Entonces
		Escribir "🤝 ¡Empate!"
	Sino
		Si (jugador = 1 Y maquina = 3) O (jugador = 2 Y maquina = 1) O (jugador = 3 Y maquina = 2) Entonces
			Escribir "🏆 ¡Ganaste!"
		Sino
			Escribir "💀 Perdiste."
		FinSi
	FinSi

FinProceso
